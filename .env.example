# Server configuration
PORT=533
HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
BRIDGE_SIP_PORT=5062
BRIDGE_BIND_HOST=127.0.0.1
# Optional fixed RTP media port range for SIP calls (open exactly this UDP range
# in the cloud firewall). Leave blank to use OS-assigned ephemeral ports.
BRIDGE_RTP_PORT_MIN=
BRIDGE_RTP_PORT_MAX=
# End a SIP call when no inbound RTP arrives for this many seconds (lost BYE
# guard; protects maxCalls slots and provider billing). 0 disables.
BRIDGE_RTP_TIMEOUT_SEC=60

# Voice & AI Provider Keys (stored server-side only, never exposed to browser localStorage)
DEEPGRAM_API_KEY=
# Local Self-Hosted Speech Service (Faster-Whisper STT + Kokoro-82M TTS + Chatterbox Voice Cloning)
SPEECH_SERVICE_URL=http://127.0.0.1:8000
SPEECH_SERVICE_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Own voice engine: leave Deepgram. Needs the speech service above and an OpenAI-compatible model.
# VOICE_ENGINE=own
# OWN_LLM_BASE_URL=http://127.0.0.1:8001/v1
# OWN_LLM_API_KEY=

# VICIdial & Asterisk Bridge Secrets (Co-Located ViciBox)
VICI_API_PASS=
# Required only for SIP Registration / Hybrid mode; stored server-side only.
VICI_SIP_PASSWORD=
AMI_SECRET=
CUSTOM_WEBHOOK_SECRET=

# Production Security (Step 4)
# Blank permits first-account bootstrap only directly on loopback. Set a strong
# password before using any remote listener, reverse proxy, preview or tunnel.
ADMIN_PASSWORD=
# Comma-separated trusted Asterisk IPs/CIDRs for SIP (:5062) & AudioSocket (:9092), e.g. 203.0.113.10
BRIDGE_ALLOWED_IPS=127.0.0.1,::1
# Set only to explicitly trusted reverse-proxy addresses/CIDRs, e.g. loopback.
TRUST_PROXY=

# --- Call screening (answering machine detection) ---
# Turn screening on/off in the console (Vici Bridge -> Call screening). These are optional tuning values.
# Same value as --secret given to deploy/vicidial-amd/install-mma-amd.sh (signs the native AMD result).
SCREENING_EVENT_SECRET=
# Authorised automated test numbers: number=label, comma separated.
SCREENING_TEST_ENDPOINTS=
# VICIdial statuses set for each outcome (must exist in VICIdial).
SCREENING_DISPO_VOICEMAIL=AA
SCREENING_DISPO_IVR=AA
SCREENING_DISPO_PRERECORDED=AA
SCREENING_DISPO_TEST_ENDPOINT=AA
SCREENING_DISPO_UNCERTAIN=NA
# Hard cap on screening time, in milliseconds.
SCREENING_MAX_MS=7000
# Short "Hello?" probe when the evidence is thin (1 = on).
SCREENING_PROBE=1

# --- Local Bridge Call Log Retention (SQLite + recordings) ---
# Maximum newest live VICIdial calls retained locally on disk (50–50000, default 5000).
BRIDGE_LOG_RETENTION=5000

# --- AWS RDS SQL Server Archive & Analytics Sync (optional) ---
# Keeps local SQLite fast for live SIP/RTP audio while archiving unlimited call logs
# (CDRs, transcripts, dispositions, screening results) to AWS RDS SQL Server.
RDS_MSSQL_ENABLED=0
RDS_MSSQL_HOST=
RDS_MSSQL_PORT=1433
RDS_MSSQL_DATABASE=voice_agent_console
RDS_MSSQL_USER=
RDS_MSSQL_PASSWORD=
RDS_MSSQL_ENCRYPT=true
RDS_MSSQL_TRUST_SERVER_CERT=false
RDS_MSSQL_TABLE_PREFIX=vac_
SCREENING_PROBE_TEXT=Hello?
SCREENING_PROBE_VOICE=aura-2-thalia-en
SCREENING_ASR_MODEL=nova-3
# Dialplan context of extensions 8369/8370, for Testing & Verification.
SCREENING_AMD_CONTEXT=default
