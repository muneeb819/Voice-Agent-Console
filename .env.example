# Server configuration
PORT=3000
HOST=0.0.0.0
AUDIOSOCKET_PORT=9092
BRIDGE_SIP_PORT=5062

# Voice & AI Provider Keys (stored server-side only, never exposed to browser localStorage)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# VICIdial & Asterisk Bridge Secrets (Co-Located ViciBox)
VICI_API_PASS=
AMI_SECRET=
CUSTOM_WEBHOOK_SECRET=

# Production Security (Step 4)
# Leave ADMIN_PASSWORD blank in dev/preview; set a strong password on public ViciBox servers!
ADMIN_PASSWORD=
# Comma-separated trusted Asterisk IPs/CIDRs for SIP (:5062) & AudioSocket (:9092), e.g. 127.0.0.1,::1,10.0.0.0/8
BRIDGE_ALLOWED_IPS=
