# Server configuration
PORT=533
HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
BRIDGE_SIP_PORT=5062
BRIDGE_BIND_HOST=127.0.0.1

# Voice & AI Provider Keys (stored server-side only, never exposed to browser localStorage)
DEEPGRAM_API_KEY=
# Local Self-Hosted Speech Service (Faster-Whisper STT + Kokoro-82M TTS + Chatterbox Voice Cloning)
SPEECH_SERVICE_URL=http://127.0.0.1:8000
SPEECH_SERVICE_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# VICIdial & Asterisk Bridge Secrets (Co-Located ViciBox)
VICI_API_PASS=
AMI_SECRET=
CUSTOM_WEBHOOK_SECRET=

# Production Security (Step 4)
# Blank permits first-account bootstrap only directly on loopback. Set a strong
# password before using any remote listener, reverse proxy, preview or tunnel.
ADMIN_PASSWORD=
# Comma-separated trusted Asterisk IPs/CIDRs for SIP (:5062) & AudioSocket (:9092), e.g. 115.186.137.240
BRIDGE_ALLOWED_IPS=127.0.0.1,::1
# Set only to explicitly trusted reverse-proxy addresses/CIDRs, e.g. loopback.
TRUST_PROXY=
