{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Voice Agent Console (TypeScript Dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx.cmd"
      },
      "args": ["src/server.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run Production Build (dist/server.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/server.js",
      "preLaunchTask": "npm: build",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run Full 36-Check Verification Suite",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx.cmd"
      },
      "args": ["tests/step4-verify.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
