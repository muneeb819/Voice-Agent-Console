{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Voice Agent Console (TypeScript Dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx.cmd"
      },
      "args": ["src/server.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "HOST": "115.186.137.240",
        "PORT": "3850",
        "BRIDGE_BIND_HOST": "115.186.137.240",
        "AUDIOSOCKET_PORT": "19092",
        "BRIDGE_SIP_PORT": "15062"
      }
    },
    {
      "name": "Run Production Build (dist/server.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/server.js",
      "preLaunchTask": "npm: build",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run Full Isolated Verification Suite",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run-tests.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
