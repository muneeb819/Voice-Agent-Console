[Unit]
Description=Deepgram + VICIdial AI Voice Agent Console & Telephony Bridge
After=network-online.target asterisk.service apache2.service httpd.service mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=voiceagent
Group=voiceagent
WorkingDirectory=/opt/voice-agent-console
EnvironmentFile=/opt/voice-agent-console/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/voice-agent-console/dist/server.js
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
