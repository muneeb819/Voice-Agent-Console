# Dependencies (dist/ is committed pre-built so 'npm start' works out of the box!)
node_modules/

# Server secrets (never commit live API keys!)
.env
.env.*
!.env.example

# Runtime SQLite databases, JSON state mirror & call audio recordings.
# Never commit local console state or recordings.
data/
# VAC_DATA_DIR may point elsewhere inside the checkout.
**/simulator-recordings/

# Generated browser-audit output (regenerate with audit/browser-smoke.cjs).
audit/browser-results.json

# OS / Editor
.DS_Store
*.log

# Local tunnel binary (large, machine-specific)
tools/cloudflared
tools/cloudflared.exe

# Runtime logs & generated download archives
logs/
*.zip

# Python environments, test caches & local speech-service runtime state
.venv/
__pycache__/
*.pyc
.pytest_cache/
speech-service/.dev-data/
speech-service/data/
