# Dependencies (dist/ is committed pre-built so 'npm start' works out of the box!)
node_modules/

# Server secrets (never commit live API keys!)
.env
.env.*
!.env.example

# Runtime SQLite databases & call audio recordings
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/recordings/*.wav

# OS / Editor
.DS_Store
*.log

# Local tunnel binary (large, machine-specific)
tools/cloudflared
tools/cloudflared.exe

# Runtime logs & generated download archives
logs/
*.zip
