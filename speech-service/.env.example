# Required: comma-separated name:secret API keys for Voice-Agent-Console / clients
SPEECH_API_KEYS=console:change-me-strong-secret

# Set to 'fake' for local CPU testing without GPU/models, or 'real' for NVIDIA GPU production
SPEECH_BACKEND=real
SPEECH_DATA_DIR=/data
SPEECH_LOG_LEVEL=INFO
SPEECH_CORS_ORIGINS=

# Faster-Whisper STT
SPEECH_STT_MODEL=large-v3-turbo
SPEECH_STT_DEVICE=cuda
SPEECH_STT_COMPUTE_TYPE=float16
SPEECH_STT_BATCH_SIZE=8

# Kokoro-82M TTS
SPEECH_TTS_DEVICE=cuda
SPEECH_TTS_VOICE=af_heart

# Optional TLS & Voice Cloning
SPEECH_DOMAIN=localhost
SPEECH_CLONE_URL=
SPEECH_CLONE_TOKEN=
